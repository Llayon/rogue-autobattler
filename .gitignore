# Godot 4+ specific ignores
.godot/
.import/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.directory
*~

# .crash files (Godot crash dumps - keep one but not many)
*.crash

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor backups
*.tmp
*.bak
*.swp
*~
# Build artifacts (templates, intermediate files).
# The web export output. The GitHub Pages artifact is NOT committed:
# the release workflow builds it from the tested SHA and publishes it
# through actions/upload-pages-artifact, so a committed copy could only
# ever be a STALE one.
build/
docs/build/
/tmp/godot*
*.tpz
android_build/  # if you ever build for Android
ios_build/
*.apk
*.ipa
*.zip