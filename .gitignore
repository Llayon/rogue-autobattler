# Godot 4+ specific ignores
.godot/
.import/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.directory
*~

# .crash files (Godot crash dumps - keep one but not many)
*.crash

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor backups
*.tmp
*.bak
*.swp
*~
# Build artifacts (templates, intermediate files).
# Note: docs/build/** IS committed (it's the GitHub Pages artifact).
/tmp/godot*
*.tpz
android_build/  # if you ever build for Android
ios_build/
*.apk
*.ipa
*.zip