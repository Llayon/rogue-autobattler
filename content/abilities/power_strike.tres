[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://core/data/ability_def.gd" id="1_abilitydef"]
[ext_resource type="Resource" path="res://content/effects/instances/power_strike_damage.tres" id="2_damage"]
[ext_resource type="Resource" path="res://content/effects/instances/power_strike_stun.tres" id="3_stun"]

[resource]
script = ExtResource("1_abilitydef")
id = &"power_strike"
