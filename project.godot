; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Rogue AutoBattler"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/utils/event_bus_autoload.gd"
ReactionSystem="*res://core/reactions/reaction_system_autoload.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; The canvas is scaled to the window and the HEIGHT grows to match the
; window's aspect. Without a stretch mode a window whose aspect
; differs from 16:9 -- every phone -- CROPS the canvas: the menu's
; title and buttons ran off the sides. Nothing in the game assumes a
; fixed height, and the controls are laid out by containers, so the
; extra height is simply used.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[filesystem]

import/file_patterns=PackedStringArray("*.tres", "*.res")

